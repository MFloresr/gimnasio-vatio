---
import Base from '../layouts/Base.astro';
---

<Base titulo="Página no encontrada" noindex>
  <section class="franja">
    <div class="contenedor" style="max-width:900px">
      <p class="led" style="font-size:3rem;margin:0">404</p>
      <h1>Serie fallida.</h1>
      <p class="texto">La página que buscas no existe o se ha movido. Vuelve al inicio o mira el horario de hoy.</p>
      <div style="display:flex;gap:16px;flex-wrap:wrap"><a class="btn" href="/">Ir al inicio</a><a class="btn btn--blanco" href="/clases/">Ver el horario</a></div>
    </div>
  </section>
</Base>
